<!DOCTYPE html>
<html>
<head>
<title>CLASSIFIED</title>
<style>
body{background:#050505;color:white;text-align:center;font-family:monospace;padding-top:20vh}
#msg,#dead{display:none}
h1{color:red}
input,button{padding:12px;margin:5px;background:#111;color:white;border:1px solid #555}
#time{color:red;font-size:20px}
</style>
</head>

<body>

<div id="login">
<h1>⚠ CLASSIFIED</h1>
<p>IDENTITY VERIFICATION REQUIRED</p>
<input id="code" type="password" placeholder="ACCESS CODE">
<button onclick="check()">VERIFY</button>
<p id="error"></p>
</div>

<div id="msg">
<h1>★ TOP SECRET ★</h1>
<p id="text">
AGENT NAME: YOUR NAME<br><br>
MISSION: YOUR DETAILS<br><br>
THIS MESSAGE WILL SELF-DESTRUCT.
</p>
<p id="time"></p>
</div>

<div id="dead">
<h1>MESSAGE DESTROYED</h1>
</div>

<script>
const PASS="FOX001";
const KEY="viewed";

if(localStorage.getItem(KEY)){
login.innerHTML="<h1>ACCESS DENIED</h1><p>MESSAGE ALREADY VIEWED.</p>";
}

function check(){
if(code.value==PASS){
localStorage.setItem(KEY,"1");
login.style.display="none";
msg.style.display="block";
let n=10;
time.innerHTML="SELF-DESTRUCT IN: "+n;
let x=setInterval(()=>{
n--;
time.innerHTML="SELF-DESTRUCT IN: "+n;
if(n<=0){
clearInterval(x);
msg.style.display="none";
dead.style.display="block";
}
},1000);
}else{
error.innerHTML="INVALID ACCESS CODE";
}
}
</script>

</body>
</html>
